# Rapscos Ayurvedic Backend Environment Template
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Timing-safe response floor in milliseconds (minimum 700ms)
MIN_AUTH_MS=700

# Invite code required to create team/owner accounts
ADMIN_INVITE_CODE=replace_with_team_invite_code

# Whitelisted CORS origins (comma-separated)
CORS_ORIGINS=https://www.rapscosbio.com,https://rapscosbio.com,http://localhost:5173

# Default admin credentials for database seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password

# Port
PORT=8777
